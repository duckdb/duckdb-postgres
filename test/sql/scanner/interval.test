# name: test/sql/scanner/interval.test
# description: Intervals
# group: [scanner]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES)

statement ok
USE s

query I
select * from intervals
----
42 days
3 years 6 months
42 years
00:42:00
00:00:42
00:00:00.42
-42 days
NULL

statement ok
USE memory

statement ok
DETACH s
