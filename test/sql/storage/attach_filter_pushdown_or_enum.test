# name: test/sql/storage/attach_filter_pushdown_or_enum.test
# description: Test filter pushdown of an OR filter with a child that cannot be pushed down
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES)

statement ok
DROP TABLE IF EXISTS s.filter_pushdown_or_enum

statement ok
DROP TYPE IF EXISTS s.filter_pushdown_mood

statement ok
CREATE TYPE s.filter_pushdown_mood AS ENUM ('sad', 'happy')

statement ok
CREATE TABLE s.filter_pushdown_or_enum(id INTEGER, m s.filter_pushdown_mood)

statement ok
INSERT INTO s.filter_pushdown_or_enum VALUES (1, 'sad'), (2, 'happy'), (3, NULL)

# ENUM comparisons are not pushed down, so neither is the OR
query I
SELECT id FROM s.filter_pushdown_or_enum WHERE m = 'happy' OR m IS NULL ORDER BY id
----
2
3

query I
SELECT id FROM s.filter_pushdown_or_enum WHERE (m = 'happy' AND m IS NOT NULL) OR m IS NULL ORDER BY id
----
2
3

query I
SELECT id FROM s.filter_pushdown_or_enum WHERE id = 1 OR id = 3 ORDER BY id
----
1
3

query II
EXPLAIN SELECT id FROM s.filter_pushdown_or_enum WHERE id = 1 OR id = 3
----
physical_plan	<REGEX>:.*Postgres Scan.*Filters:.*id = 1.*id = 3.*
