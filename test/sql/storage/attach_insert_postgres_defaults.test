# name: test/sql/storage/attach_insert_postgres_defaults.test
# description: Test inserting into Postgres tables with SERIAL, identity and DEFAULT columns
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES)

# COPY and plain INSERT statements are generated differently
foreach use_text_protocol false true

statement ok
SET pg_use_text_protocol={use_text_protocol}

statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS insert_defaults_test')

statement ok
CALL postgres_execute('s', 'CREATE TABLE insert_defaults_test (
    id SERIAL PRIMARY KEY,
    v  INTEGER,
    d  INTEGER DEFAULT 7,
    ts TIMESTAMP DEFAULT now())')

statement ok
CALL postgres_clear_cache()

# SERIAL and DEFAULT columns not specified
statement ok
INSERT INTO s.insert_defaults_test (v) VALUES (1)

# explicit values
statement ok
INSERT INTO s.insert_defaults_test (id, v, d) VALUES (100, 2, 8)

# NULL values in DEFAULT columns are replaced with the default
statement ok
INSERT INTO s.insert_defaults_test VALUES (NULL, 3, NULL, NULL)

statement ok
INSERT INTO s.insert_defaults_test DEFAULT VALUES

query IIII
SELECT id, v, d, ts IS NULL FROM s.insert_defaults_test ORDER BY id
----
1	1	7	false
2	3	7	false
3	NULL	7	false
100	2	8	false

statement ok
DELETE FROM s.insert_defaults_test

# NULL and non-NULL values in the same input
statement ok
INSERT INTO s.insert_defaults_test (v, d) SELECT i, CASE WHEN i % 3 = 0 THEN NULL ELSE i END FROM range(5000) t(i)

query IIII
SELECT COUNT(*), COUNT(DISTINCT id), SUM(v), SUM(d) FROM s.insert_defaults_test
----
5000	5000	12497500	8343336

query I
SELECT COUNT(*) FROM s.insert_defaults_test WHERE d IS DISTINCT FROM (CASE WHEN v % 3 = 0 THEN 7 ELSE v END)
----
0

statement ok
CALL postgres_execute('s', 'DROP TABLE insert_defaults_test')

# identity columns
statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS insert_identity_test')

statement ok
CALL postgres_execute('s', 'CREATE TABLE insert_identity_test (
    id_always  INTEGER GENERATED ALWAYS AS IDENTITY,
    id_default INTEGER GENERATED BY DEFAULT AS IDENTITY,
    v INTEGER)')

statement ok
CALL postgres_clear_cache()

statement ok
INSERT INTO s.insert_identity_test (v) VALUES (1), (2)

statement ok
INSERT INTO s.insert_identity_test (id_default, v) VALUES (100, 3)

query III
SELECT * FROM s.insert_identity_test ORDER BY v
----
1	1	1
2	2	2
3	100	3

statement ok
CALL postgres_execute('s', 'DROP TABLE insert_identity_test')

# every column has a default
statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS insert_all_defaults_test')

statement ok
CALL postgres_execute('s', 'CREATE TABLE insert_all_defaults_test (id SERIAL, d INTEGER DEFAULT 7)')

statement ok
CALL postgres_clear_cache()

statement ok
INSERT INTO s.insert_all_defaults_test DEFAULT VALUES

statement ok
INSERT INTO s.insert_all_defaults_test SELECT NULL, NULL FROM range(3)

query II
SELECT * FROM s.insert_all_defaults_test ORDER BY id
----
1	7
2	7
3	7
4	7

statement ok
CALL postgres_execute('s', 'DROP TABLE insert_all_defaults_test')

# table created through DuckDB keeps its default after the catalog is reloaded
statement ok
CREATE OR REPLACE TABLE s.insert_duckdb_defaults_test (i INTEGER DEFAULT 42, j INTEGER)

statement ok
INSERT INTO s.insert_duckdb_defaults_test (j) VALUES (1)

statement ok
CALL postgres_clear_cache()

statement ok
INSERT INTO s.insert_duckdb_defaults_test (j) VALUES (2)

query II
SELECT * FROM s.insert_duckdb_defaults_test ORDER BY j
----
42	1
42	2

statement ok
DROP TABLE s.insert_duckdb_defaults_test

# MERGE INTO inserts
statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS insert_merge_test')

statement ok
CALL postgres_execute('s', 'CREATE TABLE insert_merge_test (id SERIAL PRIMARY KEY, k INTEGER, d INTEGER DEFAULT 7)')

statement ok
CALL postgres_clear_cache()

statement ok
MERGE INTO s.insert_merge_test USING (SELECT 1 AS k) src ON insert_merge_test.k = src.k
WHEN NOT MATCHED THEN INSERT (k) VALUES (src.k)

query III
SELECT * FROM s.insert_merge_test
----
1	1	7

statement ok
CALL postgres_execute('s', 'DROP TABLE insert_merge_test')

endloop
