# name: test/sql/storage/attach_generated_columns.test
# description: Test inserting into Postgres tables with generated columns
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES)

# COPY and plain INSERT statements are generated differently
foreach use_text_protocol false true

statement ok
SET pg_use_text_protocol={use_text_protocol}

statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS generated_columns_test')

# VIRTUAL generated columns require Postgres 18, older versions use STORED instead
statement ok
CALL postgres_execute('s', 'DO $$ BEGIN EXECUTE format($q$CREATE TABLE generated_columns_test (
    id    INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    price NUMERIC(10,2),
    qty   INTEGER,
    total NUMERIC(12,2) GENERATED ALWAYS AS (price * qty) STORED,
    total_virtual NUMERIC(12,2) GENERATED ALWAYS AS (price * qty * 2) %s)$q$,
    CASE WHEN current_setting(''server_version_num'')::INTEGER >= 180000 THEN ''VIRTUAL'' ELSE ''STORED'' END);
END $$')

statement ok
CALL postgres_clear_cache()

# generated and identity columns not specified
statement ok
INSERT INTO s.generated_columns_test (price, qty) VALUES (2.50, 4)

# columns specified in a different order
statement ok
INSERT INTO s.generated_columns_test (qty, price) VALUES (3, 1.00)

# all columns, generated columns set to NULL
statement ok
INSERT INTO s.generated_columns_test VALUES (100, 5.00, 2, NULL, NULL)

# explicit values for generated columns are not allowed
statement error
INSERT INTO s.generated_columns_test (price, qty, total) VALUES (1.00, 1, 42)
----
generated column

statement error
INSERT INTO s.generated_columns_test (price, qty, total_virtual) VALUES (1.00, 1, 42)
----
generated column

# insert from a query
statement ok
INSERT INTO s.generated_columns_test (price, qty) SELECT 1.5, i FROM range(3) t(i)

query IIIII
SELECT * FROM s.generated_columns_test ORDER BY id
----
1	2.50	4	10.00	20.00
2	1.00	3	3.00	6.00
3	1.50	0	0.00	0.00
4	1.50	1	1.50	3.00
5	1.50	2	3.00	6.00
100	5.00	2	10.00	20.00

statement ok
CALL postgres_execute('s', 'DROP TABLE generated_columns_test')

endloop
