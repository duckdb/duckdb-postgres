# ExpressionType::COMPARE_GREATERTHAN

# FLOAT

query I
SELECT divide(COUNT(*), 1) FROM s.filter_pushdown_test_infinite WHERE col1 > 'inf'::FLOAT OR col1 > 'nan'::FLOAT OR col1 > 40.0::FLOAT
----
1

query II
EXPLAIN SELECT divide(COUNT(*), 1) FROM s.filter_pushdown_test_infinite WHERE col1 > 'inf'::FLOAT OR col1 > 'nan'::FLOAT OR col1 > 40.0::FLOAT
