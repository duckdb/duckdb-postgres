# name: test/sql/connection_pool/connection_pool_options.test
# description: Test connection pool options
# group: [connection_pool]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

statement ok
DETACH s

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, acquire_mode 
FROM postgres_configure_pool(catalog_name='s')
----
s	force

statement ok
DETACH s

statement ok
SET pg_pool_max_connections = 0

statement error
SET pg_pool_acquire_mode = 'wait'
----
pg_pool_max_connections > 0

statement ok
RESET GLOBAL pg_pool_max_connections

statement ok
SET pg_pool_acquire_mode = 'try'

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, acquire_mode 
FROM postgres_configure_pool(catalog_name='s')
----
s	try

statement ok
RESET GLOBAL pg_pool_acquire_mode

statement ok
DETACH s

statement ok
SET pg_pool_max_connections = 42

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, max_connections
FROM postgres_configure_pool(catalog_name='s')
----
s	42

statement ok
RESET GLOBAL pg_pool_max_connections

statement ok
DETACH s

statement ok
SET pg_pool_wait_timeout_millis = 42000

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, wait_timeout_millis
FROM postgres_configure_pool(catalog_name='s')
----
s	42000

statement ok
RESET GLOBAL pg_pool_wait_timeout_millis

statement ok
DETACH s

statement ok
SET pg_pool_enable_thread_local_cache = FALSE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, thread_local_cache_enabled
FROM postgres_configure_pool(catalog_name='s')
----
s	FALSE

statement ok
RESET GLOBAL pg_pool_enable_thread_local_cache

statement ok
DETACH s

statement ok
SET pg_pool_max_lifetime_millis = 42000

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, max_lifetime_millis 
FROM postgres_configure_pool(catalog_name='s')
----
s	42000

statement ok
RESET GLOBAL pg_pool_max_lifetime_millis

statement ok
DETACH s

statement ok
SET pg_pool_idle_timeout_millis = 42000

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, idle_timeout_millis 
FROM postgres_configure_pool(catalog_name='s')
----
s	42000

statement ok
RESET GLOBAL pg_pool_idle_timeout_millis

statement ok
DETACH s

statement ok
SET pg_pool_enable_reaper_thread = TRUE

statement ok
SET pg_pool_idle_timeout_millis = 42000

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, reaper_thread_running 
FROM postgres_configure_pool(catalog_name='s')
----
s	TRUE

statement ok
RESET GLOBAL pg_pool_enable_reaper_thread

statement ok
RESET GLOBAL pg_pool_idle_timeout_millis

statement ok
DETACH s

# alive bypass window

query I
SELECT current_setting('pg_pool_alive_bypass_window_millis')
----
500

statement ok
SET pg_pool_alive_bypass_window_millis = 42

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, alive_bypass_window_millis
FROM postgres_configure_pool(catalog_name='s')
----
s	42

statement ok
RESET GLOBAL pg_pool_alive_bypass_window_millis

statement ok
DETACH s

# legacy options

statement ok
SET pg_connection_limit = 42

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, max_connections
FROM postgres_configure_pool(catalog_name='s')
----
s	42

query I
SELECT current_setting('pg_pool_max_connections')
----
42

statement ok
RESET GLOBAL pg_connection_limit

statement ok
DETACH s

statement ok
SET pg_connection_cache = FALSE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, max_connections
FROM postgres_configure_pool(catalog_name='s')
----
s	0

query I
SELECT current_setting('pg_pool_max_connections')
----
0

statement ok
RESET GLOBAL pg_connection_cache

statement ok
DETACH s

# health check query

query I
SELECT current_setting('pg_pool_health_check_query')
----
SELECT 1

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query II
SELECT catalog_name, available_connections
FROM postgres_configure_pool(catalog_name='s')
----
s	1

statement ok
DETACH s

statement ok
SET GLOBAL pg_pool_health_check_query = 'SELECT_FAIL'

# the health check is not run within the alive bypass window
statement ok
SET GLOBAL pg_pool_alive_bypass_window_millis = 0

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES);

query I
SELECT current_setting('pg_pool_health_check_query')
----
SELECT_FAIL

query II
SELECT catalog_name, alive_bypass_window_millis
FROM postgres_configure_pool(catalog_name='s')
----
s	0

statement ok
SET VARIABLE cache_misses_before = (SELECT cache_misses FROM postgres_configure_pool(catalog_name='s'))

query I
FROM postgres_query('s', 'SELECT 42')
----
42

# the connection failed the health check when it was taken from the pool, it was discarded and a new one was opened
query III
SELECT catalog_name, available_connections, cache_misses - getvariable('cache_misses_before') > 0
FROM postgres_configure_pool(catalog_name='s')
----
s	1	TRUE

statement ok
RESET GLOBAL pg_pool_health_check_query

statement ok
RESET GLOBAL pg_pool_alive_bypass_window_millis

statement ok
DETACH s
