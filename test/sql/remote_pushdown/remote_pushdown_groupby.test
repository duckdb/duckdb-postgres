# name: test/sql/remote_pushdown/remote_pushdown_groupby.test
# description: Test remote pushdown of GROUP BY / HAVING / grouping sets into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

statement ok
CREATE OR REPLACE TABLE s.rp_groupby AS SELECT i, i % 3 AS g, i % 2 AS h, CASE WHEN i % 4 = 0 THEN NULL ELSE 'v' || (i % 4) END AS v FROM range(12) t(i)

query IIIII
SELECT g, COUNT(*), SUM(i), MIN(v), MAX(v) FROM s.rp_groupby GROUP BY g ORDER BY g
----
0	4	18	v1	v3
1	4	22	v1	v3
2	4	26	v1	v3

query II
EXPLAIN SELECT g, COUNT(*), SUM(i), MIN(v), MAX(v) FROM s.rp_groupby GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:(?s).*GROUP BY "g" ORDER BY "g" ASC NULLS LAST.*

# positional GROUP BY and ORDER BY
query III
SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY 1, 2 ORDER BY 2, 1
----
0	0	2
1	0	2
2	0	2
0	1	2
1	1	2
2	1	2

query II
EXPLAIN SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY 1, 2 ORDER BY 2, 1
----
physical_plan	<REGEX>:(?s).*GROUP BY 1, 2 ORDER BY 2 ASC NULLS LAST, 1 ASC NULLS LAST.*

# grouping by an alias
query II
SELECT i % 3 AS grp, COUNT(*) FROM s.rp_groupby GROUP BY grp ORDER BY grp
----
0	4
1	4
2	4

query II
EXPLAIN SELECT i % 3 AS grp, COUNT(*) FROM s.rp_groupby GROUP BY grp ORDER BY grp
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# grouping by an expression
query II
SELECT i % 3 + 1, COUNT(*) FROM s.rp_groupby GROUP BY i % 3 + 1 ORDER BY 1
----
1	4
2	4
3	4

query II
EXPLAIN SELECT i % 3 + 1, COUNT(*) FROM s.rp_groupby GROUP BY i % 3 + 1 ORDER BY 1
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# NULL groups
query II
SELECT v, COUNT(*) FROM s.rp_groupby GROUP BY v ORDER BY v
----
v1	3
v2	3
v3	3
NULL	3

query II
EXPLAIN SELECT v, COUNT(*) FROM s.rp_groupby GROUP BY v ORDER BY v
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT v, COUNT(*) FROM s.rp_groupby GROUP BY v ORDER BY v DESC NULLS LAST
----
v3	3
v2	3
v1	3
NULL	3

query II
EXPLAIN SELECT v, COUNT(*) FROM s.rp_groupby GROUP BY v ORDER BY v DESC NULLS LAST
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# HAVING
query II
SELECT g, SUM(i) FROM s.rp_groupby GROUP BY g HAVING SUM(i) > 15 ORDER BY g
----
0	18
1	22
2	26

query II
EXPLAIN SELECT g, SUM(i) FROM s.rp_groupby GROUP BY g HAVING SUM(i) > 15 ORDER BY g
----
physical_plan	<REGEX>:(?s).*HAVING \(sum\("i"\) > 15\).*

query I rowsort
SELECT COUNT(*) FROM s.rp_groupby HAVING COUNT(*) > 5
----
12

query II
EXPLAIN SELECT COUNT(*) FROM s.rp_groupby HAVING COUNT(*) > 5
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# HAVING referencing an alias is not supported in Postgres
query II
SELECT g, SUM(i) AS total FROM s.rp_groupby GROUP BY g HAVING total > 15 ORDER BY g
----
0	18
1	22
2	26

query II
EXPLAIN SELECT g, SUM(i) AS total FROM s.rp_groupby GROUP BY g HAVING total > 15 ORDER BY g
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# aggregates with DISTINCT
query III rowsort
SELECT COUNT(DISTINCT g), SUM(DISTINCT h), COUNT(DISTINCT v) FROM s.rp_groupby
----
3	1	3

query II
EXPLAIN SELECT COUNT(DISTINCT g), SUM(DISTINCT h), COUNT(DISTINCT v) FROM s.rp_groupby
----
physical_plan	<REGEX>:(?s).*count\(DISTINCT "g"\).*

# GROUP BY ALL is DuckDB-specific
query III
SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY ALL ORDER BY ALL
----
0	0	2
0	1	2
1	0	2
1	1	2
2	0	2
2	1	2

query II
EXPLAIN SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY ALL ORDER BY ALL
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# ORDER BY ALL is serialized with positional references
query III
SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY g, h ORDER BY ALL DESC
----
2	1	2
2	0	2
1	1	2
1	0	2
0	1	2
0	0	2

query II
EXPLAIN SELECT g, h, COUNT(*) FROM s.rp_groupby GROUP BY g, h ORDER BY ALL DESC
----
physical_plan	<REGEX>:(?s).*ORDER BY 1 DESC NULLS LAST, 2 DESC NULLS LAST, 3 DESC NULLS LAST.*

# grouping sets, ROLLUP and CUBE
query III
SELECT g, h, SUM(i) FROM s.rp_groupby GROUP BY GROUPING SETS ((g), (h), ()) ORDER BY ALL
----
0	NULL	18
1	NULL	22
2	NULL	26
NULL	0	30
NULL	1	36
NULL	NULL	66

query II
EXPLAIN SELECT g, h, SUM(i) FROM s.rp_groupby GROUP BY GROUPING SETS ((g), (h), ()) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*GROUP BY GROUPING SETS \(\("g"\), \("h"\), \(\)\).*

query III
SELECT g, h, SUM(i) FROM s.rp_groupby GROUP BY ROLLUP (g, h) ORDER BY ALL
----
0	0	6
0	1	12
0	NULL	18
1	0	14
1	1	8
1	NULL	22
2	0	10
2	1	16
2	NULL	26
NULL	NULL	66

query II
EXPLAIN SELECT g, h, SUM(i) FROM s.rp_groupby GROUP BY ROLLUP (g, h) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIIII
SELECT g, h, SUM(i), GROUPING(g), GROUPING(g, h) FROM s.rp_groupby GROUP BY CUBE (g, h) ORDER BY ALL
----
0	0	6	0	0
0	1	12	0	0
0	NULL	18	0	1
1	0	14	0	0
1	1	8	0	0
1	NULL	22	0	1
2	0	10	0	0
2	1	16	0	0
2	NULL	26	0	1
NULL	0	30	1	2
NULL	1	36	1	2
NULL	NULL	66	1	3

query II
EXPLAIN SELECT g, h, SUM(i), GROUPING(g), GROUPING(g, h) FROM s.rp_groupby GROUP BY CUBE (g, h) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIII
SELECT g, h, COUNT(*), GROUPING_ID(g, h) FROM s.rp_groupby GROUP BY CUBE (g, h) ORDER BY ALL
----
0	0	2	0
0	1	2	0
0	NULL	4	1
1	0	2	0
1	1	2	0
1	NULL	4	1
2	0	2	0
2	1	2	0
2	NULL	4	1
NULL	0	6	2
NULL	1	6	2
NULL	NULL	12	3

query II
EXPLAIN SELECT g, h, COUNT(*), GROUPING_ID(g, h) FROM s.rp_groupby GROUP BY CUBE (g, h) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT g % 2 AS gg, h, COUNT(*) FROM s.rp_groupby GROUP BY ROLLUP (gg, h) ORDER BY ALL
----
0	0	4
0	1	4
0	NULL	8
1	0	2
1	1	2
1	NULL	4
NULL	NULL	12

query II
EXPLAIN SELECT g % 2 AS gg, h, COUNT(*) FROM s.rp_groupby GROUP BY ROLLUP (gg, h) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# grouped aggregates in a subquery
query I rowsort
SELECT MAX(cnt) FROM (SELECT g, COUNT(*) AS cnt FROM s.rp_groupby GROUP BY g)
----
4

query II
EXPLAIN SELECT MAX(cnt) FROM (SELECT g, COUNT(*) AS cnt FROM s.rp_groupby GROUP BY g)
----
physical_plan	<REGEX>:(?s).*Postgres Query.*
