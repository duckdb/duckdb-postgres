# name: test/sql/remote_pushdown/remote_pushdown_edge_cases.test
# description: Test edge cases of remote pushdown into Postgres
# group: [remote_pushdown]

require postgres_scanner

require icu

require-env POSTGRES_TEST_DATABASE_AVAILABLE

# setting the time zone also loads ICU when the test runner autoloads extensions instead of loading them with
# "require" (e.g. with LOCAL_EXTENSION_REPO) - and makes the results independent of the time zone of the machine
statement ok
SET TimeZone = 'UTC'

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# DESC: Test edge cases of remote pushdown into Postgres
statement ok
CREATE OR REPLACE TABLE s.rp_edge AS SELECT i, CASE WHEN i % 3 = 0 THEN NULL ELSE i END AS n, 'v' || i AS v FROM range(6) t(i)

# empty results
query III rowsort
SELECT SUM(i), COUNT(*), MAX(v) FROM s.rp_edge WHERE i > 100
----
NULL	0	NULL

query II
EXPLAIN SELECT SUM(i), COUNT(*), MAX(v) FROM s.rp_edge WHERE i > 100
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II rowsort
SELECT g, COUNT(*) FROM (SELECT i % 2 AS g FROM s.rp_edge) WHERE g > 5 GROUP BY g
----

query II
EXPLAIN SELECT g, COUNT(*) FROM (SELECT i % 2 AS g FROM s.rp_edge) WHERE g > 5 GROUP BY g
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# aggregates over NULLs
query IIIIII
SELECT SUM(n), AVG(n), MIN(n), COUNT(n), COUNT(*), string_agg(CAST(n AS VARCHAR), ',' ORDER BY n) FROM s.rp_edge
----
12	3.0	1	4	6	1,2,4,5

query II
EXPLAIN SELECT SUM(n), AVG(n), MIN(n), COUNT(n), COUNT(*), string_agg(CAST(n AS VARCHAR), ',' ORDER BY n) FROM s.rp_edge
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II rowsort
SELECT SUM(n), AVG(n) FROM s.rp_edge WHERE n IS NULL
----
NULL	NULL

query II
EXPLAIN SELECT SUM(n), AVG(n) FROM s.rp_edge WHERE n IS NULL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# three-valued logic
query IIIIIII
SELECT i, n > 2, NOT (n > 2), n > 2 OR i > 3, n > 2 AND i > 3, n = NULL, n IS NULL FROM s.rp_edge ORDER BY i
----
0	NULL	NULL	NULL	false	NULL	true
1	false	true	false	false	NULL	false
2	false	true	false	false	NULL	false
3	NULL	NULL	NULL	false	NULL	true
4	true	false	true	true	NULL	false
5	true	false	true	true	NULL	false

query II
EXPLAIN SELECT i, n > 2, NOT (n > 2), n > 2 OR i > 3, n > 2 AND i > 3, n = NULL, n IS NULL FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_edge WHERE NOT (n IN (1, 2)) ORDER BY i
----
4
5

query II
EXPLAIN SELECT i FROM s.rp_edge WHERE NOT (n IN (1, 2)) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_edge WHERE n NOT IN (SELECT n FROM s.rp_edge WHERE n > 3) ORDER BY i
----
1
2

query II
EXPLAIN SELECT i FROM s.rp_edge WHERE n NOT IN (SELECT n FROM s.rp_edge WHERE n > 3) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# constant expressions are evaluated locally
query IIII
SELECT i + (2 * 3), CAST('2024-01-01' AS DATE) + 1, 'abc' || 'def', length('hello') FROM s.rp_edge ORDER BY i
----
6	2024-01-02	abcdef	5
7	2024-01-02	abcdef	5
8	2024-01-02	abcdef	5
9	2024-01-02	abcdef	5
10	2024-01-02	abcdef	5
11	2024-01-02	abcdef	5

query II
EXPLAIN SELECT i + (2 * 3), CAST('2024-01-01' AS DATE) + 1, 'abc' || 'def', length('hello') FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_edge WHERE i > abs(-2) ORDER BY i
----
3
4
5

query II
EXPLAIN SELECT i FROM s.rp_edge WHERE i > abs(-2) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# value functions are evaluated locally once
query I rowsort
SELECT COUNT(*) FROM s.rp_edge WHERE current_date > DATE '2020-01-01'
----
6

query I rowsort
SELECT COUNT(*) FROM s.rp_edge WHERE now() > TIMESTAMPTZ '2020-01-01 00:00:00+00'
----
6

# volatile functions are executed locally
query I rowsort
SELECT COUNT(*) FROM s.rp_edge WHERE random() < 2
----
6

query II
EXPLAIN SELECT COUNT(*) FROM s.rp_edge WHERE random() < 2
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

query I rowsort
SELECT COUNT(gen_random_uuid()) FROM s.rp_edge
----
6

query II
EXPLAIN SELECT COUNT(gen_random_uuid()) FROM s.rp_edge
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# macros
statement ok
CREATE MACRO rp_double(x) AS x * 2

query I
SELECT rp_double(i) FROM s.rp_edge ORDER BY i
----
0
2
4
6
8
10

query II
EXPLAIN SELECT rp_double(i) FROM s.rp_edge ORDER BY i
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

query I
SELECT i + rp_double(21) FROM s.rp_edge ORDER BY i
----
42
43
44
45
46
47

query II
EXPLAIN SELECT i + rp_double(21) FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# integer overflow raises an error in both systems
statement error
SELECT CAST(i AS INTEGER) * 2147483647 FROM s.rp_edge WHERE i = 5
----
out of range

# division by zero yields inf / nan
query IIII
SELECT i, i / 0, n / 0, 0 / n FROM s.rp_edge ORDER BY i
----
0	nan	NULL	NULL
1	inf	inf	0.0
2	inf	inf	0.0
3	inf	NULL	NULL
4	inf	inf	0.0
5	inf	inf	0.0

query II
EXPLAIN SELECT i, i / 0, n / 0, 0 / n FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# integer division by zero raises an error in both systems
statement error
SELECT i % 0 FROM s.rp_edge
----
zero

# deeply nested expressions
query II
SELECT ((((i + 1) * 2) - 3) * (i + 4)) % 7, CASE WHEN i > 1 THEN CASE WHEN i > 3 THEN 'big' ELSE 'mid' END ELSE 'small' END FROM s.rp_edge ORDER BY i
----
-4	small
5	small
4	mid
0	mid
0	big
4	big

query II
EXPLAIN SELECT ((((i + 1) * 2) - 3) * (i + 4)) % 7, CASE WHEN i > 1 THEN CASE WHEN i > 3 THEN 'big' ELSE 'mid' END ELSE 'small' END FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# strings with quotes / backslashes / unicode
query IIII
SELECT i, v || '''quoted''', v || E'\\backslash\\', v || '🦆' FROM s.rp_edge WHERE v <> 'it''s' ORDER BY i
----
0	v0'quoted'	v0\backslash\	v0🦆
1	v1'quoted'	v1\backslash\	v1🦆
2	v2'quoted'	v2\backslash\	v2🦆
3	v3'quoted'	v3\backslash\	v3🦆
4	v4'quoted'	v4\backslash\	v4🦆
5	v5'quoted'	v5\backslash\	v5🦆

query II
EXPLAIN SELECT i, v || '''quoted''', v || E'\\backslash\\', v || '🦆' FROM s.rp_edge WHERE v <> 'it''s' ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I rowsort
SELECT COUNT(*) FROM s.rp_edge WHERE v LIKE '%\\%' OR v LIKE 'v_'
----
6

query II
EXPLAIN SELECT COUNT(*) FROM s.rp_edge WHERE v LIKE '%\\%' OR v LIKE 'v_'
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# DISTINCT on expressions
query II
SELECT DISTINCT i % 2, n IS NULL FROM s.rp_edge ORDER BY ALL
----
0	false
0	true
1	false
1	true

query II
EXPLAIN SELECT DISTINCT i % 2, n IS NULL FROM s.rp_edge ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# LIMIT 0
query I
SELECT i FROM s.rp_edge ORDER BY i LIMIT 0
----

query II
EXPLAIN SELECT i FROM s.rp_edge ORDER BY i LIMIT 0
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# subquery in the SELECT list returning no rows
query II
SELECT i, (SELECT n FROM s.rp_edge e2 WHERE e2.i = rp_edge.i + 100) FROM s.rp_edge ORDER BY i
----
0	NULL
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL

query II
EXPLAIN SELECT i, (SELECT n FROM s.rp_edge e2 WHERE e2.i = rp_edge.i + 100) FROM s.rp_edge ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*
