1	1	1
2	2	2
3	0	3
4	1	4
5	2	5
6	0	6
7	1	7
8	2	8
9	0	9

query II
EXPLAIN SELECT i, MIN(i) OVER w, MAX(i) OVER w FROM s.rp_window WINDOW w AS (PARTITION BY g ORDER BY i) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# filtering on window results in a subquery
query III
SELECT * FROM (SELECT i, g, row_number() OVER (PARTITION BY g ORDER BY i DESC) AS rn FROM s.rp_window) WHERE rn = 1 ORDER BY g
----
9	0	1
7	1	1
8	2	1

query II
EXPLAIN SELECT * FROM (SELECT i, g, row_number() OVER (PARTITION BY g ORDER BY i DESC) AS rn FROM s.rp_window) WHERE rn = 1 ORDER BY g
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# QUALIFY is not supported in Postgres
query II
SELECT i, g FROM s.rp_window QUALIFY row_number() OVER (PARTITION BY g ORDER BY i DESC) = 1 ORDER BY g
----
9	0
7	1
8	2

query II
EXPLAIN SELECT i, g FROM s.rp_window QUALIFY row_number() OVER (PARTITION BY g ORDER BY i DESC) = 1 ORDER BY g
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# IGNORE NULLS / DISTINCT / ORDER BY arguments are not pushed down
query II
SELECT i, last_value(v IGNORE NULLS) OVER (ORDER BY i) FROM s.rp_window ORDER BY i
