# name: test/sql/remote_pushdown/remote_pushdown_values.test
# description: Test remote pushdown of VALUES lists and table functions into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

statement ok
CREATE OR REPLACE TABLE s.rp_vals AS SELECT i, 'v' || i AS v FROM range(5) t(i)

# VALUES lists are named the way DuckDB names them
query IIII
SELECT * FROM s.rp_vals JOIN (VALUES (1, 'a'), (3, 'c')) t(x, y) ON i = x ORDER BY i
----
1	v1	1	a
3	v3	3	c

query II
EXPLAIN SELECT * FROM s.rp_vals JOIN (VALUES (1, 'a'), (3, 'c')) t(x, y) ON i = x ORDER BY i
----
physical_plan	<REGEX>:(?s).*\(VALUES \(1, 'a'\), \(3, 'c'\)\) AS "valueslist"\("col0", "col1"\).*

query III
SELECT i, col0, col1 FROM s.rp_vals, (VALUES (10, 'x'), (NULL, NULL)) ORDER BY i, col0
----
0	10	x
0	NULL	NULL
1	10	x
1	NULL	NULL
2	10	x
2	NULL	NULL
3	10	x
3	NULL	NULL
4	10	x
4	NULL	NULL

query II
EXPLAIN SELECT i, col0, col1 FROM s.rp_vals, (VALUES (10, 'x'), (NULL, NULL)) ORDER BY i, col0
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT * FROM (VALUES (1), (3), (NULL)) t(x) LEFT JOIN s.rp_vals ON x = i ORDER BY x
----
1	1	v1
3	3	v3
NULL	NULL	NULL

query II
EXPLAIN SELECT * FROM (VALUES (1), (3), (NULL)) t(x) LEFT JOIN s.rp_vals ON x = i ORDER BY x
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_vals WHERE i IN (SELECT * FROM (VALUES (2), (4))) ORDER BY i
----
2
4

query II
EXPLAIN SELECT i FROM s.rp_vals WHERE i IN (SELECT * FROM (VALUES (2), (4))) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIIII
SELECT * FROM s.rp_vals, (VALUES (DATE '2024-01-01', 1.5, true)) v(d, n, b) ORDER BY i
----
0	v0	2024-01-01	1.5	true
1	v1	2024-01-01	1.5	true
2	v2	2024-01-01	1.5	true
3	v3	2024-01-01	1.5	true
4	v4	2024-01-01	1.5	true

query II
EXPLAIN SELECT * FROM s.rp_vals, (VALUES (DATE '2024-01-01', 1.5, true)) v(d, n, b) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# table functions - DuckDB's range excludes the upper bound
query II
SELECT i, r FROM s.rp_vals, range(3) t(r) ORDER BY i, r
----
0	0
0	1
0	2
1	0
1	1
1	2
2	0
2	1
2	2
3	0
3	1
3	2
4	0
4	1
4	2

query II
EXPLAIN SELECT i, r FROM s.rp_vals, range(3) t(r) ORDER BY i, r
----
physical_plan	<REGEX>:(?s).*generate_series\(CAST\(0 AS BIGINT\), CAST\(3 AS BIGINT\) - 1\) AS "t"\("r"\).*

query II
SELECT i, range FROM s.rp_vals, range(1, 3) ORDER BY i, range
----
0	1
0	2
1	1
1	2
2	1
2	2
3	1
3	2
4	1
4	2

query II
EXPLAIN SELECT i, range FROM s.rp_vals, range(1, 3) ORDER BY i, range
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, t FROM s.rp_vals, range(10, 2, -3) t ORDER BY i, t
----
0	4
0	7
0	10
1	4
1	7
1	10
2	4
2	7
2	10
3	4
3	7
3	10
4	4
4	7
4	10

query II
EXPLAIN SELECT i, t FROM s.rp_vals, range(10, 2, -3) t ORDER BY i, t
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, r FROM s.rp_vals, range(0, 7, 3) t(r) ORDER BY i, r
----
0	0
0	3
0	6
1	0
1	3
1	6
2	0
2	3
2	6
3	0
3	3
3	6
4	0
4	3
4	6

query II
EXPLAIN SELECT i, r FROM s.rp_vals, range(0, 7, 3) t(r) ORDER BY i, r
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, generate_series FROM s.rp_vals, generate_series(1, 2) ORDER BY ALL
----
0	1
0	2
1	1
1	2
2	1
2	2
3	1
3	2
4	1
4	2

query II
EXPLAIN SELECT i, generate_series FROM s.rp_vals, generate_series(1, 2) ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*generate_series\(CAST\(1 AS BIGINT\), CAST\(2 AS BIGINT\)\) AS "generate_series".*

query II
SELECT i, x FROM s.rp_vals, generate_series(5, 1, -2) t(x) ORDER BY i, x
----
0	1
0	3
0	5
1	1
1	3
1	5
2	1
2	3
2	5
3	1
3	3
3	5
4	1
4	3
4	5

query II
EXPLAIN SELECT i, x FROM s.rp_vals, generate_series(5, 1, -2) t(x) ORDER BY i, x
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT * FROM s.rp_vals, generate_series(1, i) t(x) ORDER BY i, x
----
1	v1	1
2	v2	1
2	v2	2
3	v3	1
3	v3	2
3	v3	3
4	v4	1
4	v4	2
4	v4	3
4	v4	4

query II
EXPLAIN SELECT * FROM s.rp_vals, generate_series(1, i) t(x) ORDER BY i, x
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT i, x, ordinality FROM s.rp_vals, generate_series(i, i + 1) WITH ORDINALITY t(x, ordinality) ORDER BY i, x
----
0	0	1
0	1	2
1	1	1
1	2	2
2	2	1
2	3	2
3	3	1
3	4	2
4	4	1
4	5	2

query II
EXPLAIN SELECT i, x, ordinality FROM s.rp_vals, generate_series(i, i + 1) WITH ORDINALITY t(x, ordinality) ORDER BY i, x
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I rowsort
SELECT typeof(r) FROM s.rp_vals, range(1) t(r) LIMIT 1
----
BIGINT

# table functions that are not available in Postgres (note: lists / timestamps as arguments of table functions are not
# tested, they trigger a use-after-free in the remote pushdown optimizer of DuckDB v2.0.0)
query II
SELECT i, x FROM s.rp_vals, unnest(string_split(v, '_')) t(x) ORDER BY i, x
----
0	v0
1	v1
2	v2
3	v3
4	v4

query II
EXPLAIN SELECT i, x FROM s.rp_vals, unnest(string_split(v, '_')) t(x) ORDER BY i, x
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*
