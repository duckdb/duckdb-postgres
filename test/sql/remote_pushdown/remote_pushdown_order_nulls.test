# name: test/sql/remote_pushdown/remote_pushdown_order_nulls.test
# description: Test NULL ordering in remote pushdown into Postgres - Postgres sorts NULLs as larger than any value
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# DESC: Test NULL ordering in remote pushdown into Postgres - Postgres sorts NULLs as larger than any value
statement ok
CREATE OR REPLACE TABLE s.rp_nulls AS SELECT i, CASE WHEN i % 3 = 0 THEN NULL ELSE i % 4 END AS n, CASE WHEN i % 4 = 1 THEN NULL ELSE 'v' || (i % 3) END AS v FROM range(9) t(i)

query II
SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
4	0
8	0
1	1
5	1
2	2
7	3
0	NULL
3	NULL
6	NULL

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
physical_plan	<REGEX>:(?s).*ORDER BY "n" ASC NULLS LAST, "i" ASC NULLS LAST.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
7	3
2	2
1	1
5	1
4	0
8	0
0	NULL
3	NULL
6	NULL

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
physical_plan	<REGEX>:(?s).*ORDER BY "n" DESC NULLS LAST.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY n NULLS FIRST, i DESC
----
6	NULL
3	NULL
0	NULL
8	0
4	0
5	1
1	1
2	2
7	3

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n NULLS FIRST, i DESC
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY n DESC NULLS FIRST, i
----
0	NULL
3	NULL
6	NULL
7	3
2	2
1	1
5	1
4	0
8	0

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n DESC NULLS FIRST, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, v FROM s.rp_nulls ORDER BY v DESC, i
----
2	v2
8	v2
4	v1
7	v1
0	v0
3	v0
6	v0
1	NULL
5	NULL

query II
EXPLAIN SELECT i, v FROM s.rp_nulls ORDER BY v DESC, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY 2, 1 LIMIT 4
----
4	0
8	0
1	1
5	1

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY 2, 1 LIMIT 4
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT n, COUNT(*) FROM s.rp_nulls GROUP BY n ORDER BY n DESC
----
3	1
2	1
1	2
0	2
NULL	3

query II
EXPLAIN SELECT n, COUNT(*) FROM s.rp_nulls GROUP BY n ORDER BY n DESC
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, row_number() OVER (ORDER BY n DESC, i) FROM s.rp_nulls ORDER BY i
----
0	7
1	3
2	2
3	8
4	5
5	4
6	9
7	1
8	6

query II
EXPLAIN SELECT i, row_number() OVER (ORDER BY n DESC, i) FROM s.rp_nulls ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT string_agg(i, ',' ORDER BY n NULLS FIRST, i) FROM (SELECT i::VARCHAR i, n FROM s.rp_nulls)
----
0,3,6,4,8,1,5,2,7

query II
EXPLAIN SELECT string_agg(i, ',' ORDER BY n NULLS FIRST, i) FROM (SELECT i::VARCHAR i, n FROM s.rp_nulls)
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# the default NULL order setting is respected
statement ok
SET default_null_order = 'nulls_first'

query II
SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
0	NULL
3	NULL
6	NULL
4	0
8	0
1	1
5	1
2	2
7	3

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
0	NULL
3	NULL
6	NULL
7	3
2	2
1	1
5	1
4	0
8	0

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

statement ok
SET default_null_order = 'nulls_first_on_asc_last_on_desc'

query II
SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
0	NULL
3	NULL
6	NULL
4	0
8	0
1	1
5	1
2	2
7	3

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
7	3
2	2
1	1
5	1
4	0
8	0
0	NULL
3	NULL
6	NULL

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n DESC, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

statement ok
SET default_order = 'DESC'

query II
SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
7	3
2	2
5	1
1	1
8	0
4	0
6	NULL
3	NULL
0	NULL

query II
EXPLAIN SELECT i, n FROM s.rp_nulls ORDER BY n, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

statement ok
RESET default_order

statement ok
RESET default_null_order
