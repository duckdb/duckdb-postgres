# name: test/sql/remote_pushdown/remote_pushdown_functions_date.test
# description: Test remote pushdown of date / time functions into Postgres
# group: [remote_pushdown]

require postgres_scanner

require icu

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# setting the time zone also loads ICU when the test runner autoloads extensions instead of loading them with
# "require" (e.g. with LOCAL_EXTENSION_REPO) - and makes the results independent of the time zone of the machine
statement ok
SET TimeZone = 'UTC'

statement ok
CREATE OR REPLACE TABLE s.rp_date AS SELECT i, DATE '2023-12-25' + (i * 17)::INT AS dt, TIMESTAMP '1969-12-31 22:30:00.123456' + INTERVAL (i * 7) HOUR + INTERVAL (i * 13) MINUTE + INTERVAL (i * 1001) MILLISECOND AS ts, INTERVAL (i * 30) HOUR + INTERVAL (i) MONTH AS iv, TIME '10:15:30' + INTERVAL (i * 7) MINUTE AS tm FROM range(10) t(i)

statement ok
CREATE OR REPLACE TABLE s.rp_date_tz AS SELECT i, TIMESTAMPTZ '2024-03-30 22:00:00+00' + INTERVAL (i * 5) HOUR AS tstz FROM range(10) t(i)

# date parts are serialized as EXTRACT
query IIIIIIIIII
SELECT i, year(dt), month(dt), day(dt), quarter(dt), dayofweek(dt), isodow(dt), dayofyear(dt), week(dt), isoyear(dt) FROM s.rp_date ORDER BY i
----
0	2023	12	25	4	1	1	359	52	2023
1	2024	1	11	1	4	4	11	2	2024
2	2024	1	28	1	0	7	28	4	2024
3	2024	2	14	1	3	3	45	7	2024
4	2024	3	2	1	6	6	62	9	2024
5	2024	3	19	1	2	2	79	12	2024
6	2024	4	5	2	5	5	96	14	2024
7	2024	4	22	2	1	1	113	17	2024
8	2024	5	9	2	4	4	130	19	2024
9	2024	5	26	2	0	7	147	21	2024

query II
EXPLAIN SELECT i, year(dt), month(dt), day(dt), quarter(dt), dayofweek(dt), isodow(dt), dayofyear(dt), week(dt), isoyear(dt) FROM s.rp_date ORDER BY i
----
physical_plan	<REGEX>:(?s).*CAST\(EXTRACT\(MONTH FROM "dt"\) AS BIGINT\).*

