# Postgres has no modulo for doubles
query II
SELECT id, x % 2 FROM s.rp_math ORDER BY id
----
1	0.49999999999999994
2	0.6749999999999998
3	-0.5
4	-0.4
5	nan
6	nan
7	nan
8	0.5
9	1.5
10	0.0
11	NULL
12	0.5678000000000338

query II
EXPLAIN SELECT id, x % 2 FROM s.rp_math ORDER BY id
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# DuckDB's integer division
query II
SELECT id, n // 2 FROM s.rp_math ORDER BY id
