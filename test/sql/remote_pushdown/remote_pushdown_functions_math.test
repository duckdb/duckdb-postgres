# name: test/sql/remote_pushdown/remote_pushdown_functions_math.test
# description: Test remote pushdown of numeric functions into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

statement ok
CREATE OR REPLACE TABLE s.rp_math AS SELECT * FROM (VALUES (1, 0.49999999999999994::DOUBLE, 7, 1.255::DECIMAL(10,3)), (2, 2.675, -7, -2.5), (3, -2.5, 0, 0.5), (4, -0.4, 12, 125.125), (5, 'inf', 3, 1), (6, '-inf', -3, -1.5), (7, 'nan', 5, 2.675), (8, 0.5, 100, NULL), (9, 1.5, NULL, 0), (10, 0.0, 1, 9.999), (11, NULL, 2, 3), (12, 1234.5678, -12, -0.005)) t(id, x, n, dec)

# arithmetic - DuckDB's division always yields a DOUBLE, and division by zero yields inf / nan
query IIIIIII
SELECT id, n + 1, n - 1, n * 2, n / 4, n % 5, -n FROM s.rp_math ORDER BY id
----
1	8	6	14	1.75	2	-7
2	-6	-8	-14	-1.75	-2	7
3	1	-1	0	0.0	0	0
4	13	11	24	3.0	2	-12
5	4	2	6	0.75	3	-3
6	-2	-4	-6	-0.75	-3	3
7	6	4	10	1.25	0	-5
8	101	99	200	25.0	0	-100
9	NULL	NULL	NULL	NULL	NULL	NULL
10	2	0	2	0.25	1	-1
11	3	1	4	0.5	2	-2
12	-11	-13	-24	-3.0	-2	12

query II
EXPLAIN SELECT id, n + 1, n - 1, n * 2, n / 4, n % 5, -n FROM s.rp_math ORDER BY id
----
physical_plan	<REGEX>:(?s).*\(CAST\("n" AS DOUBLE PRECISION\) / 4\).*

query IIIIII
