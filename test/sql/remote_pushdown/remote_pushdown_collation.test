# name: test/sql/remote_pushdown/remote_pushdown_collation.test
# description: Test that remote pushdown into Postgres orders strings like DuckDB, independent of the database collation
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# DESC: Test that remote pushdown into Postgres orders strings like DuckDB, independent of the database collation
statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS rp_coll_list')

statement ok
CREATE OR REPLACE TABLE s.rp_coll AS SELECT * FROM (VALUES (1, 'a', 1), (2, 'B', 2), (3, '_x', 1), (4, 'b', 2), (5, 'A', 1), (6, 'é', 2), (7, 'Z', 1), (8, NULL, 2), (9, 'a b', 1), (10, 'ab', 2)) t(id, v, g)

# DuckDB orders strings byte-wise - if the database collation differs (e.g. en_US), the C collation is pinned
query I
SELECT v FROM s.rp_coll ORDER BY v
----
A
B
Z
_x
a
a b
ab
b
é
NULL

query II
EXPLAIN SELECT v FROM s.rp_coll ORDER BY v
----
physical_plan	<REGEX>:(?s).*ORDER BY ("v"|CAST\("v" AS TEXT\) COLLATE "C") ASC NULLS LAST.*

query II
SELECT id, v FROM s.rp_coll ORDER BY v DESC NULLS FIRST, id
----
8	NULL
6	é
4	b
10	ab
9	a b
1	a
3	_x
7	Z
2	B
5	A

query II
EXPLAIN SELECT id, v FROM s.rp_coll ORDER BY v DESC NULLS FIRST, id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT v || '!' AS w FROM s.rp_coll ORDER BY w
----
A!
B!
Z!
_x!
a b!
a!
ab!
b!
é!
NULL

query II
EXPLAIN SELECT v || '!' AS w FROM s.rp_coll ORDER BY w
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT v || '?' AS w, id FROM s.rp_coll ORDER BY 1, 2
----
A?	5
B?	2
Z?	7
_x?	3
a b?	9
a?	1
ab?	10
b?	4
é?	6
NULL	8

query II
EXPLAIN SELECT v || '?' AS w, id FROM s.rp_coll ORDER BY 1, 2
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT g, max(v) AS mx, min(v) AS mn FROM s.rp_coll GROUP BY g ORDER BY ALL
----
1	a b	A
2	é	B

query II
EXPLAIN SELECT g, max(v) AS mx, min(v) AS mn FROM s.rp_coll GROUP BY g ORDER BY ALL
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT id, v FROM s.rp_coll WHERE v < 'b' ORDER BY id
----
1	a
2	B
3	_x
5	A
7	Z
9	a b
10	ab

query II
EXPLAIN SELECT id, v FROM s.rp_coll WHERE v < 'b' ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT id FROM s.rp_coll WHERE v BETWEEN 'B' AND 'a' ORDER BY id
----
1
2
3
7

query II
EXPLAIN SELECT id FROM s.rp_coll WHERE v BETWEEN 'B' AND 'a' ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT id FROM s.rp_coll WHERE v > ANY (SELECT v FROM s.rp_coll WHERE id IN (1, 2)) ORDER BY id
----
1
3
4
6
7
9
10

query II
EXPLAIN SELECT id FROM s.rp_coll WHERE v > ANY (SELECT v FROM s.rp_coll WHERE id IN (1, 2)) ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT id, greatest(v, 'a'), least(v, 'Z') FROM s.rp_coll ORDER BY id
----
1	a	Z
2	a	B
3	a	Z
4	b	Z
5	a	A
6	é	Z
7	a	Z
8	a	Z
9	a b	Z
10	ab	Z

query II
EXPLAIN SELECT id, greatest(v, 'a'), least(v, 'Z') FROM s.rp_coll ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIII
SELECT g, string_agg(v, ',' ORDER BY v), arg_min(id, v), arg_max(id, v) FROM s.rp_coll GROUP BY g ORDER BY g
----
1	A,Z,_x,a,a b	5	9
2	B,ab,b,é	2	6

query II
EXPLAIN SELECT g, string_agg(v, ',' ORDER BY v), arg_min(id, v), arg_max(id, v) FROM s.rp_coll GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II rowsort
SELECT median(v), quantile_disc(v, 0.25) FROM s.rp_coll
----
a	Z

query II
EXPLAIN SELECT median(v), quantile_disc(v, 0.25) FROM s.rp_coll
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIII
SELECT id, v, row_number() OVER (ORDER BY v), max(v) OVER (PARTITION BY g ORDER BY id) FROM s.rp_coll ORDER BY id
----
1	a	5	a
2	B	2	B
3	_x	4	a
4	b	8	b
5	A	1	a
6	é	9	é
7	Z	3	a
8	NULL	10	é
9	a b	6	a b
10	ab	7	é

query II
EXPLAIN SELECT id, v, row_number() OVER (ORDER BY v), max(v) OVER (PARTITION BY g ORDER BY id) FROM s.rp_coll ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT DISTINCT ON (g) g, v FROM s.rp_coll ORDER BY g, v
----
1	A
2	B

query II
SELECT a.id, b.id FROM s.rp_coll a JOIN s.rp_coll b ON a.v < b.v WHERE a.id = 1 ORDER BY 1, 2
----
1	4
1	6
1	9
1	10

query II
EXPLAIN SELECT a.id, b.id FROM s.rp_coll a JOIN s.rp_coll b ON a.v < b.v WHERE a.id = 1 ORDER BY 1, 2
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT id, v FROM s.rp_coll WHERE CASE WHEN v >= 'a' THEN true ELSE false END ORDER BY id
----
1	a
4	b
6	é
9	a b
10	ab

query II
EXPLAIN SELECT id, v FROM s.rp_coll WHERE CASE WHEN v >= 'a' THEN true ELSE false END ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

statement ok
CREATE OR REPLACE TABLE s.rp_coll_list AS SELECT id, [v, 'x'] AS l FROM (VALUES (1, 'a'), (2, 'B'), (3, '_x'), (4, NULL)) t(id, v)

query II
SELECT id, l FROM s.rp_coll_list ORDER BY l, id
----
2	[B, x]
3	[_x, x]
1	[a, x]
4	[NULL, x]

query II
EXPLAIN SELECT id, l FROM s.rp_coll_list ORDER BY l, id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT id FROM s.rp_coll_list WHERE l > ['B', 'x'] ORDER BY id
----
1
3
4

query I
WITH c AS (SELECT v FROM s.rp_coll) SELECT v FROM c ORDER BY v
----
A
B
Z
_x
a
a b
ab
b
é
NULL

query II
EXPLAIN WITH c AS (SELECT v FROM s.rp_coll) SELECT v FROM c ORDER BY v
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT * FROM (SELECT v FROM s.rp_coll ORDER BY v LIMIT 4) ORDER BY v
----
A
B
Z
_x

query II
EXPLAIN SELECT * FROM (SELECT v FROM s.rp_coll ORDER BY v LIMIT 4) ORDER BY v
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# set operations, DISTINCT and DISTINCT aggregates cannot pin the collation of string keys - with such a database
# collation they are executed locally
query I
SELECT v FROM s.rp_coll WHERE id < 5 UNION SELECT v FROM s.rp_coll WHERE id >= 5 ORDER BY v
----
A
B
Z
_x
a
a b
ab
b
é
NULL

query I
SELECT DISTINCT v FROM s.rp_coll ORDER BY v
----
A
B
Z
_x
a
a b
ab
b
é
NULL

query I
SELECT string_agg(DISTINCT v, ',' ORDER BY v) FROM s.rp_coll
----
A,B,Z,_x,a,a b,ab,b,é

query II
SELECT g, list(v ORDER BY v) FROM s.rp_coll GROUP BY g ORDER BY g
----
1	[A, Z, _x, a, a b]
2	[B, ab, b, é, NULL]

# DML with string comparisons
statement ok
CREATE OR REPLACE TABLE s.rp_coll_dml AS SELECT * FROM s.rp_coll

statement ok
UPDATE s.rp_coll_dml SET g = 0 WHERE v < 'a'

query I
SELECT id FROM s.rp_coll_dml WHERE g = 0 ORDER BY id
----
2
3
5
7

statement ok
DELETE FROM s.rp_coll_dml WHERE v BETWEEN 'a' AND 'b'

query I
SELECT id FROM s.rp_coll_dml ORDER BY id
----
2
3
5
6
7
8

# CREATE TABLE AS with string ordering - with such a database collation only the query is pushed down
statement ok
CREATE OR REPLACE TABLE s.rp_coll_ctas AS SELECT id, v FROM s.rp_coll WHERE v < 'b'

query I
SELECT id FROM s.rp_coll_ctas ORDER BY id
----
1
2
3
5
7
9
10

statement ok
DROP TABLE s.rp_coll_ctas

statement ok
DROP TABLE s.rp_coll_dml

statement ok
DROP TABLE s.rp_coll_list

statement ok
DROP TABLE s.rp_coll
