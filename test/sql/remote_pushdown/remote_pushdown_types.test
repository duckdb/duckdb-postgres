# name: test/sql/remote_pushdown/remote_pushdown_types.test
# description: Test remote pushdown of queries over Postgres types that DuckDB reads as different types
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# DESC: Test remote pushdown of queries over Postgres types that DuckDB reads as different types
statement ok
CALL postgres_execute('s', 'DROP TABLE IF EXISTS rp_types')

statement ok
CALL postgres_execute('s', 'CREATE TABLE rp_types (id INT, ip INET, m MONEY, j JSONB, js JSON, n NUMERIC, b BIT(3), c CHAR(4))')

statement ok
CALL postgres_execute('s', 'INSERT INTO rp_types VALUES (1, ''10.0.0.1'', 12.5, ''{"a": 1}'', ''{"b": 2}'', 1.5, B''101'', ''ab''), (2, ''::1'', 3, ''[1]'', ''[]'', 0.1, B''001'', ''abcd''), (3, ''10.0.0.1/8'', 100, ''{}'', ''{}'', 1e20, NULL, NULL)')

statement ok
CALL postgres_clear_cache()

# references to these columns are cast to the type DuckDB reads them as - so they are compared / ordered the same
query II
SELECT id, m FROM s.rp_types ORDER BY m
----
3	$100.00
1	$12.50
2	$3.00

query II
EXPLAIN SELECT id, m FROM s.rp_types ORDER BY m
----
physical_plan	<REGEX>:(?s).*ORDER BY (CAST\("m" AS TEXT\)|CAST\(CAST\("m" AS TEXT\) AS TEXT\) COLLATE "C") ASC NULLS LAST.*

query I rowsort
SELECT COUNT(*) FROM s.rp_types WHERE ip = '10.0.0.1/32'
----
1

query II
EXPLAIN SELECT COUNT(*) FROM s.rp_types WHERE ip = '10.0.0.1/32'
----
physical_plan	<REGEX>:(?s).*WHERE \(CAST\("ip" AS TEXT\) = '10\.0\.0\.1/32'\).*

query II
SELECT ip, COUNT(*) FROM s.rp_types GROUP BY ip ORDER BY ip
----
10.0.0.1/32	1
10.0.0.1/8	1
::1/128	1

query II
EXPLAIN SELECT ip, COUNT(*) FROM s.rp_types GROUP BY ip ORDER BY ip
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIIII
SELECT MIN(j), MAX(js), MAX(b), MIN(c), string_agg(ip, ',' ORDER BY ip) FROM s.rp_types
----
[1]	{}	101	ab	10.0.0.1/32,10.0.0.1/8,::1/128

query II
EXPLAIN SELECT MIN(j), MAX(js), MAX(b), MIN(c), string_agg(ip, ',' ORDER BY ip) FROM s.rp_types
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIII
SELECT id, length(ip), j || '!', lower(js) FROM s.rp_types ORDER BY id
----
1	11	{"a": 1}!	{"b": 2}
2	7	[1]!	[]
3	10	{}!	{}

query II
EXPLAIN SELECT id, length(ip), j || '!', lower(js) FROM s.rp_types ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIIII
SELECT id, c, length(c), c || '!', c = 'ab' FROM s.rp_types ORDER BY id
----
1	ab	2	ab!	true
2	abcd	4	abcd!	false
3	NULL	NULL	NULL	NULL

query II
EXPLAIN SELECT id, c, length(c), c || '!', c = 'ab' FROM s.rp_types ORDER BY id
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# unconstrained NUMERIC values are read as DOUBLE
query III
SELECT id, n * 3, SUM(n) OVER () FROM s.rp_types ORDER BY id
----
1	4.5	1e+20
2	0.30000000000000004	1e+20
3	3e+20	1e+20

query II
EXPLAIN SELECT id, n * 3, SUM(n) OVER () FROM s.rp_types ORDER BY id
----
physical_plan	<REGEX>:(?s).*\(CAST\("n" AS DOUBLE PRECISION\) \* 3\).*

query II rowsort
SELECT typeof(n), typeof(SUM(n)) FROM s.rp_types GROUP BY ALL
----
DOUBLE	DOUBLE

statement ok
CALL postgres_execute('s', 'DROP TABLE rp_types')
