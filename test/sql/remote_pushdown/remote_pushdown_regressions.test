# name: test/sql/remote_pushdown/remote_pushdown_regressions.test
# description: Regression tests for the translation of expressions in remote pushdown into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

# DESC: Regression tests for the translation of expressions in remote pushdown into Postgres
statement ok
CREATE OR REPLACE TABLE s.rp_reg AS SELECT i::INTEGER AS i, i % 3 AS g, CASE WHEN i % 4 = 0 THEN NULL ELSE 'v' || (i % 4) END AS v, DATE '2024-01-01' + i::INTEGER AS d, i % 2 = 0 AS b, (i * 1.5)::DOUBLE AS f FROM range(8) t(i)

# typed NULLs
query III
SELECT i, CAST(NULL AS INTEGER) + i, COALESCE(NULL::VARCHAR, v) FROM s.rp_reg ORDER BY i
----
0	NULL	NULL
1	NULL	v1
2	NULL	v2
3	NULL	v3
4	NULL	NULL
5	NULL	v1
6	NULL	v2
7	NULL	v3

query II
EXPLAIN SELECT i, CAST(NULL AS INTEGER) + i, COALESCE(NULL::VARCHAR, v) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# comparisons of columns with constants of other types
query I
SELECT i FROM s.rp_reg WHERE d > '2024-01-03' ORDER BY i
----
3
4
5
6
7

query II
EXPLAIN SELECT i FROM s.rp_reg WHERE d > '2024-01-03' ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_reg WHERE i = '3' OR f < 2 ORDER BY i
----
0
1
3

query II
EXPLAIN SELECT i FROM s.rp_reg WHERE i = '3' OR f < 2 ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# aggregates of booleans and floats
query IIII rowsort
SELECT min(b), max(b), sum(f), avg(i) FROM s.rp_reg
----
false	true	42.0	3.5

query II
EXPLAIN SELECT min(b), max(b), sum(f), avg(i) FROM s.rp_reg
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT g, max(b), min(v) FROM s.rp_reg GROUP BY g ORDER BY g
----
0	true	v2
1	true	v1
2	true	v1

query II
EXPLAIN SELECT g, max(b), min(v) FROM s.rp_reg GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# integer arguments of string functions
query IIIII
SELECT i, left(v, i), right(v, g), lpad(v, i, '*'), repeat(v, g) FROM s.rp_reg ORDER BY i
----
0	NULL	NULL	NULL	NULL
1	v	1	v	v1
2	v2	v2	v2	v2v2
3	v3	(empty)	*v3	(empty)
4	NULL	NULL	NULL	NULL
5	v1	v1	***v1	v1v1
6	v2	(empty)	****v2	(empty)
7	v3	3	*****v3	v3

query II
EXPLAIN SELECT i, left(v, i), right(v, g), lpad(v, i, '*'), repeat(v, g) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, substr(v, g, 2) FROM s.rp_reg ORDER BY i
----
0	NULL
1	v1
2	2
3	v
4	NULL
5	1
6	v
7	v3

query II
EXPLAIN SELECT i, substr(v, g, 2) FROM s.rp_reg ORDER BY i
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

query II
SELECT i, substr(v, 2, 2) FROM s.rp_reg ORDER BY i
----
0	NULL
1	1
2	2
3	3
4	NULL
5	1
6	2
7	3

query II
EXPLAIN SELECT i, substr(v, 2, 2) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# unicode of empty strings
query II
SELECT i, unicode(COALESCE(v, '')) FROM s.rp_reg ORDER BY i
----
0	-1
1	118
2	118
3	118
4	-1
5	118
6	118
7	118

query II
EXPLAIN SELECT i, unicode(COALESCE(v, '')) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# date parts of BC dates
query III
SELECT year(DATE '0044-03-15' - INTERVAL 100 YEAR), yearweek(d), isoyear(d) FROM s.rp_reg ORDER BY i LIMIT 2
----
-56	202401	2024
-56	202401	2024

query II
SELECT i, year(d - INTERVAL 2100 YEAR) FROM s.rp_reg ORDER BY i
----
0	-76
1	-76
2	-76
3	-76
4	-76
5	-76
6	-76
7	-76

query II
EXPLAIN SELECT i, year(d - INTERVAL 2100 YEAR) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# DISTINCT with ORDER BY on columns of the select list
query II
SELECT DISTINCT g, v FROM s.rp_reg ORDER BY v NULLS FIRST, g
----
0	NULL
1	NULL
1	v1
2	v1
0	v2
2	v2
0	v3
1	v3

query II
EXPLAIN SELECT DISTINCT g, v FROM s.rp_reg ORDER BY g DESC
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT DISTINCT g FROM s.rp_reg ORDER BY i
----
0
1
2

query II
EXPLAIN SELECT DISTINCT g FROM s.rp_reg ORDER BY i
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*

# RANGE frame offsets
query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 2 PRECEDING AND CURRENT ROW) FROM s.rp_reg ORDER BY i
----
0	0
1	1
2	3
3	6
4	9
5	12
6	15
7	18

query II
EXPLAIN SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 2 PRECEDING AND CURRENT ROW) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT i, count(*) OVER (ORDER BY d RANGE BETWEEN INTERVAL 2 DAY PRECEDING AND INTERVAL 1 DAY FOLLOWING) FROM s.rp_reg ORDER BY i
----
0	2
1	3
2	4
3	4
4	4
5	4
6	4
7	3

query II
EXPLAIN SELECT i, count(*) OVER (ORDER BY d RANGE BETWEEN INTERVAL 2 DAY PRECEDING AND INTERVAL 1 DAY FOLLOWING) FROM s.rp_reg ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# ordering by expressions
query II
SELECT i, v FROM s.rp_reg ORDER BY v DESC NULLS LAST, i % 3, i
----
3	v3
7	v3
6	v2
2	v2
1	v1
5	v1
0	NULL
4	NULL

query II
EXPLAIN SELECT i, v FROM s.rp_reg ORDER BY v DESC NULLS LAST, i % 3, i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

statement ok
DROP TABLE s.rp_reg
