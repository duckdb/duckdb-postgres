# name: test/sql/remote_pushdown/remote_pushdown_functions_string.test
# description: Test remote pushdown of string functions into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

statement ok
CREATE OR REPLACE TABLE s.rp_str AS SELECT i, CASE WHEN i % 5 = 0 THEN NULL ELSE 'Str_' || i || ' ÄÉ' END AS v, ' pad ' || i AS p FROM range(8) t(i)

# string functions with identical semantics
query IIIIII
SELECT i, length(v), len(v), char_length(v), strlen(v), bit_length(v) FROM s.rp_str ORDER BY i
----
0	NULL	NULL	NULL	NULL	NULL
1	8	8	8	10	80
2	8	8	8	10	80
3	8	8	8	10	80
4	8	8	8	10	80
5	NULL	NULL	NULL	NULL	NULL
6	8	8	8	10	80
7	8	8	8	10	80

query II
EXPLAIN SELECT i, length(v), len(v), char_length(v), strlen(v), bit_length(v) FROM s.rp_str ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query IIIIII
SELECT i, concat(v, '-', i), concat_ws('|', v, NULL, p), v || '!', replace(v, 'Str', 'X'), repeat(v, 2) FROM s.rp_str ORDER BY i
