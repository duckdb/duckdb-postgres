# LIKE has no default escape character in DuckDB
query IIIII
SELECT i, v LIKE 'Str\_%', v NOT LIKE '%1%', v ILIKE 'str_%', v NOT ILIKE '%ä%' FROM s.rp_str ORDER BY i
----
0	NULL	NULL	NULL	NULL
1	false	false	true	false
2	false	true	true	false
3	false	true	true	false
4	false	true	true	false
5	NULL	NULL	NULL	NULL
6	false	true	true	false
7	false	true	true	false

query II
EXPLAIN SELECT i, v LIKE 'Str\_%', v NOT LIKE '%1%', v ILIKE 'str_%', v NOT ILIKE '%ä%' FROM s.rp_str ORDER BY i
----
physical_plan	<REGEX>:(?s).*\("v" LIKE E'Str\\\\_%' ESCAPE ''\).*

query I rowsort
SELECT COUNT(*) FROM s.rp_str WHERE v LIKE '%\%'
----
0

query II
EXPLAIN SELECT COUNT(*) FROM s.rp_str WHERE v LIKE '%\%'
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

