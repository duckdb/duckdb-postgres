# name: test/sql/remote_pushdown/remote_pushdown_subquery.test
# description: Test remote pushdown of subqueries into Postgres
# group: [remote_pushdown]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, SCHEMA 'public')

statement ok
CREATE OR REPLACE TABLE s.rp_sq1 AS SELECT i, i % 3 AS g, CASE WHEN i = 4 THEN NULL ELSE i END AS n FROM range(6) t(i)

statement ok
CREATE OR REPLACE TABLE s.rp_sq2 AS SELECT i AS k, i * 10 AS w FROM range(2, 9) t(i)

# scalar subqueries
query II
SELECT i, (SELECT MAX(w) FROM s.rp_sq2 WHERE k = i) FROM s.rp_sq1 ORDER BY i
----
0	NULL
1	NULL
2	20
3	30
4	40
5	50

query II
EXPLAIN SELECT i, (SELECT MAX(w) FROM s.rp_sq2 WHERE k = i) FROM s.rp_sq1 ORDER BY i
----
physical_plan	<REGEX>:(?s).*\(SELECT max\("w"\) AS "max\(w\)" FROM "public"\."rp_sq2" WHERE \("k" = "i"\)\).*

query I
SELECT i FROM s.rp_sq1 WHERE i > (SELECT AVG(k) FROM s.rp_sq2) ORDER BY i
----

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i > (SELECT AVG(k) FROM s.rp_sq2) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II rowsort
SELECT (SELECT COUNT(*) FROM s.rp_sq1), (SELECT SUM(w) FROM s.rp_sq2)
----
6	350

query II
EXPLAIN SELECT (SELECT COUNT(*) FROM s.rp_sq1), (SELECT SUM(w) FROM s.rp_sq2)
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# EXISTS
query I
SELECT i FROM s.rp_sq1 WHERE EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i) ORDER BY i
----
2
3
4
5

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i) ORDER BY i
----
physical_plan	<REGEX>:(?s).*EXISTS\(SELECT 1.*

query I
SELECT i FROM s.rp_sq1 WHERE NOT EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i) ORDER BY i
----
0
1

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE NOT EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i) ORDER BY i
----
physical_plan	<REGEX>:(?s).*NOT EXISTS\(SELECT 1.*

query II
SELECT i, EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i * 2) FROM s.rp_sq1 ORDER BY i
----
0	false
1	true
2	true
3	true
4	true
5	false

query II
EXPLAIN SELECT i, EXISTS (SELECT 1 FROM s.rp_sq2 WHERE k = i * 2) FROM s.rp_sq1 ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# IN / ANY / ALL
query I
SELECT i FROM s.rp_sq1 WHERE i IN (SELECT k FROM s.rp_sq2) ORDER BY i
----
2
3
4
5

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i IN (SELECT k FROM s.rp_sq2) ORDER BY i
----
physical_plan	<REGEX>:(?s).*\("i" = ANY\(SELECT "k" FROM "public"\."rp_sq2"\)\).*

query I
SELECT i FROM s.rp_sq1 WHERE i NOT IN (SELECT k FROM s.rp_sq2) ORDER BY i
----
0
1

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i NOT IN (SELECT k FROM s.rp_sq2) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query III
SELECT i, n IN (SELECT k FROM s.rp_sq2), n NOT IN (SELECT k FROM s.rp_sq2 WHERE k < 4) FROM s.rp_sq1 ORDER BY i
----
0	false	true
1	false	true
2	true	false
3	true	false
4	NULL	NULL
5	true	true

query II
EXPLAIN SELECT i, n IN (SELECT k FROM s.rp_sq2), n NOT IN (SELECT k FROM s.rp_sq2 WHERE k < 4) FROM s.rp_sq1 ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_sq1 WHERE i > ALL (SELECT g FROM s.rp_sq1) ORDER BY i
----
3
4
5

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i > ALL (SELECT g FROM s.rp_sq1) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_sq1 WHERE i < ANY (SELECT k FROM s.rp_sq2 WHERE k < 4) ORDER BY i
----
0
1
2

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i < ANY (SELECT k FROM s.rp_sq2 WHERE k < 4) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query I
SELECT i FROM s.rp_sq1 WHERE i IN (SELECT k FROM s.rp_sq2 ORDER BY k LIMIT 2) ORDER BY i
----
2
3

query II
EXPLAIN SELECT i FROM s.rp_sq1 WHERE i IN (SELECT k FROM s.rp_sq2 ORDER BY k LIMIT 2) ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# NULL semantics of IN lists
query IIII
SELECT i, n IN (1, 2, NULL), n NOT IN (3, 4), n NOT IN (3, NULL) FROM s.rp_sq1 ORDER BY i
----
0	NULL	true	NULL
1	true	true	NULL
2	true	true	NULL
3	NULL	false	false
4	NULL	NULL	NULL
5	NULL	true	NULL

query II
EXPLAIN SELECT i, n IN (1, 2, NULL), n NOT IN (3, 4), n NOT IN (3, NULL) FROM s.rp_sq1 ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# subqueries in FROM
query II
SELECT g, MAX(s) FROM (SELECT g, i + n AS s FROM s.rp_sq1) GROUP BY g ORDER BY g
----
0	6
1	2
2	10

query II
EXPLAIN SELECT g, MAX(s) FROM (SELECT g, i + n AS s FROM s.rp_sq1) GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT * FROM (SELECT * FROM (SELECT i, n FROM s.rp_sq1 WHERE i > 1) WHERE n IS NOT NULL) t ORDER BY i
----
2	2
3	3
5	5

query II
EXPLAIN SELECT * FROM (SELECT * FROM (SELECT i, n FROM s.rp_sq1 WHERE i > 1) WHERE n IS NOT NULL) t ORDER BY i
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

query II
SELECT t.x, t.y FROM (SELECT i, g FROM s.rp_sq1) t(x, y) ORDER BY x
----
0	0
1	1
2	2
3	0
4	1
5	2

query II
EXPLAIN SELECT t.x, t.y FROM (SELECT i, g FROM s.rp_sq1) t(x, y) ORDER BY x
----
physical_plan	<REGEX>:(?s).*Postgres Query.*

# correlated subqueries referencing a local table are not pushed down
statement ok
CREATE TABLE local_sq AS SELECT 3 AS i

query II rowsort
SELECT i, (SELECT MAX(w) FROM s.rp_sq2 WHERE k = local_sq.i) FROM local_sq
----
3	30

query II
EXPLAIN SELECT i, (SELECT MAX(w) FROM s.rp_sq2 WHERE k = local_sq.i) FROM local_sq
----
physical_plan	<!REGEX>:(?s).*Postgres Query.*
